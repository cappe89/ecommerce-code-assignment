# ========================================================
# Production Environment Variables Reference (.env.production)
# ========================================================

# Application Configuration
# APP_PORT defines the host port mapped to the container (default: 80 for production HTTP)
APP_PORT=80
NODE_ENV=production

# MySQL Database Configuration
# When running with docker-compose.prod.yml, DB_HOST is set to the service name 'mysql'
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ecommerce
DB_USERNAME=ecommerce_user
DB_PASSWORD=your_strong_production_password_here
MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password_here

# ORM & Logging Settings
DB_LOGGING=false
# Strict production safeguard: never alter schemas automatically via sync in production
DB_SYNC=false
