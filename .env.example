# Application Configuration
PORT=3000
NODE_ENV=development # 'development' (local dev with auto-seeding), 'test', or 'production'

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=ecommerce_user
DB_PASSWORD=ecommerce_pass
DB_NAME=ecommerce
DB_LOGGING=false
DB_SYNC=true # true for local development, false for production releases
