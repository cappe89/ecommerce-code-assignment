{
  "name": "products-service",
  "version": "1.0.0",
  "description": "Products Microservice built with NestJS, Sequelize, and MySQL",
  "author": "Alessandro Cappelletti",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles",
    "docker:build": "docker build -t ecommerce-products-microservice:latest .",
    "docker:dev:up": "docker-compose up -d",
    "docker:dev:down": "docker-compose down",
    "docker:prod:up": "docker-compose -p ecommerce-prod -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker-compose -p ecommerce-prod -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -p ecommerce-prod -f docker-compose.prod.yml logs -f",
    "docker:prod:sync": "docker exec -it ecommerce_prod_app node dist/scripts/sync-schema.js",
    "db:sync": "cross-env ts-node -r tsconfig-paths/register src/scripts/sync-schema.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/sequelize": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true,
              "useDefineForClassFields": false
            }
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules[\\\\/](?!(@nestjs)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.model.(t|j)s",
      "!**/*.dto.(t|j)s",
      "!main.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
